        "v": "Stage 1\n(Performing)",
        "f": 0
       },
       {
        "v": "12-Month ECL",
        "f": 0
       },
       {
        "v": "No significant increase in lifetime PD since origination.",
        "f": 0
       },
       {
        "v": "None; active monitoring.",
        "f": 0
       },
