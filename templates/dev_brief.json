    {
     "t": "h",
     "text": "1.2 Core Mathematical Formulation"
    },
    {
     "t": "para",
     "label": "",
     "c": {
      "v": "For each facility i at reporting date t = 0, probability-weighted Expected Credit Loss is computed across discrete time horizons t = 1, 2, ..., T (where T = 12 months for Stage 1 and T = contractual/behavioral maturity for Stage 2 and Stage 3) across S macroeconomic scenarios:",
      "f": 0
     }
    },
    {
     "t": "formula",
     "c": {
      "v": "ECL_i = Sum_{s=1..S} W_s * Sum_{t=1..T} [ Marginal_PD_{i,t,s} * LGD_{i,t,s} * EAD_{i,t,s} * DF_{i,t} ]",
      "f": 0
     }
    },
    {
     "t": "list",
     "items": [
      {
       "label": "Marginal_PD_{i,t,s}:",
       "c": {
        "v": "Conditional probability of defaulting during interval t, given survival up to t - 1 under scenario s.",
        "f": 0
       }
      },
      {
       "label": "LGD_{i,t,s}:",
       "c": {
        "v": "Forward-looking economic Loss Given Default expressed as a percentage of EAD at time t under scenario s.",
        "f": 0
       }
      },
      {
       "label": "EAD_{i,t,s}:",
       "c": {
        "v": "Projected Exposure at Default at time t incorporating scheduled amortization, prepayments, and undrawn credit conversion.",
        "f": 0
       }
      },
      {
       "label": "DF_{i,t}:",
       "c": {
        "v": "Discount factor computed using the instrument's Effective Interest Rate (EIR), defined as 1 / (1 + EIR)^t.",
        "f": 0
       }
      },
      {
       "label": "W_s:",
       "c": {
        "v": "Probability weight assigned to macroeconomic scenario s, such that Sum(W_s) = 1.",
        "f": 0
       }
      }
     ]
    },
    {
