  {
   "title": "2. Regulatory & Accounting Alignment",
   "goal": "Map accounting rules directly to code logic so auditors can verify compliance without reading raw scripts.\nClearly document exact numerical thresholds for Default, Curing, and Significant Increase in Credit Risk (SICR).",
   "rep": false,
   "blocks": [
    {
     "t": "h",
     "text": "2.1 Definition of Default (DoD) & Curing Rules"
    },
    {
     "t": "para",
     "label": "",
     "c": {
      "v": "The Definition of Default is aligned with [Basel / CRR Article 178 / RBI Prudential Norms on Income Recognition and Asset Classification] and applied consistently across PD, LGD, and EAD modeling:",
      "f": 1
     }
    },
    {
     "t": "list",
     "items": [
      {
       "label": "Quantitative Backstop:",
       "c": {
        "v": "Obligor/facility is [90]+ days past due (DPD) on any material credit obligation ([specify materiality threshold, e.g., INR 5,000 / 1% of exposure]).",
        "f": 1
       }
      },
      {
       "label": "Unlikeliness to Pay (UTP) Triggers:",
       "c": {
        "v": "Distressed restructuring/forbearance with economic loss > [1%], bankruptcy/insolvency filing, fraud, charge-off, or non-accrual status.",
        "f": 1
       }
      },
      {
       "label": "Contagion / Pull-Through Rule:",
       "c": {
        "v": "[Applied at Borrower / Obligor level for Corporate & SME; applied at Facility / Borrower level for Retail].",
        "f": 1
       }
      },
      {
       "label": "Curing & Probation Period:",
       "c": {
        "v": "A defaulted facility returns to performing status only after [90 / 180 / 365] consecutive days of full contractual payments and clearance of all arrears.",
        "f": 1
       }
      }
     ]
    },
    {
     "t": "h",
     "text": "2.2 Staging & Significant Increase in Credit Risk (SICR) Criteria"
    },
    {
     "t": "para",
     "label": "",
     "c": {
      "v": "Exposures are classified into three impairment stages at each reporting date based on credit deterioration since initial recognition:",
